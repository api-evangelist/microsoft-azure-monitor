      "name": "Logs Ingestion",
      "description": {
        "content": "Operations for ingesting custom log data into Azure Monitor",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "e3c46b86-b2f8-4184-afec-b1bc8ad7994c",
          "name": "Azure Monitor Upload logs to a custom table",
          "request": {
            "name": "Azure Monitor Upload logs to a custom table",
            "description": {
              "content": "Ingests log data to a Log Analytics workspace via a data collection rule. The data is sent to the specified stream, which is mapped to a table in the workspace by the data collection rule. Supports JSON arrays of log records.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "dataCollectionRules",
                ":ruleId",
                "streams",
                ":stream"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api-version",
                  "value": "2023-01-01",
                  "description": "(Required) The API version to use for this operation."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "ruleId",
                  "description": "(Required) The immutable ID of the data collection rule resource."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "stream",
                  "description": "(Required) The name of the stream to send data to. For built-in tables, use the stream name format like Custom-TableName. For custom tables, use Custom-TableName_CL."
                },
                {
                  "description": "The data collection endpoint host.",
                  "type": "any",
                  "value": "{{dataCollectionEndpoint}}",
                  "key": "dataCollectionEndpoint"
                }
              ]
            },
            "header": [
              {
                "disabled": false,
